{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tiny Tapeout Shuttle Info Schema",
  "type": "object",
  "properties": {
    "version": { "type": "integer", "minimum": 3, "maximum": 3 },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "repo": { "type": "string", "format": "uri" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["project", "group", "subtile"],
            "default": "project"
          },
          "macro": { "type": "string" },
          "address": { "type": "integer" },
          "title": { "type": "string" },
          "author": { "type": "string" },
          "description": { "type": "string" },
          "clock_hz": { "type": "integer" },
          "tiles": { "type": "string", "pattern": "^[1-8]+x[124]|0$" },
          "analog_pins": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "repo": { "type": "string", "format": "uri" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}|$" },
          "pinout": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z_]+\\[\\d+\\]$"
            },
            "additionalProperties": { "type": "string" }
          },
          "danger_level": {
            "type": "string",
            "enum": ["unknown", "safe", "medium", "high"],
            "default": "unknown",
            "description": "Indicates the safety level of the design: 'safe' = design is safe to run, 'medium' = design can damage the ASIC under certain conditions, 'high' = design will damage the ASIC, 'unknown' = safety level is unknown"
          },
          "danger_reason": {
            "type": "string",
            "description": "Explanation of why the danger level is set to 'medium' or 'high'"
          },
          "subtile_addr": {
            "type": "integer",
            "description": "Index of the design within the group (for subtile designs)"
          },
          "subtile_addr_bits": {
            "type": "integer",
            "description": "Number of bits used to select the subtile (uio pins)"
          },
          "subtile_group": {
            "type": "string",
            "description": "Name of the group that the design belongs to (for subtile designs)"
          },
          "demo": {
            "type": "object",
            "description": "Present if the design is included in the demo board's demo mode loop (from the shuttle's projects/demo.yaml), with optional settings for showing it",
            "properties": {
              "duration_ms": {
                "type": "integer",
                "minimum": 1,
                "description": "How long to show the design, in milliseconds"
              },
              "clock_hz": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000,
                "description": "Project clock to use for the demo, overriding clock_hz"
              },
              "ui_in": { "type": "integer", "minimum": 0, "maximum": 255 },
              "uio_oe_pico": { "type": "integer", "minimum": 0, "maximum": 255 },
              "uio_in": { "type": "integer", "minimum": 0, "maximum": 255 },
              "keys": {
                "type": "object",
                "description": "Inputs to play while the design is shown: each step either sets a value ('ui': ui_in; 'gamepad': a 12-bit Gamepad Pmod report) or waits; when the steps run out the design is reset and they start over",
                "properties": {
                  "via": { "type": "string", "enum": ["ui", "gamepad"] },
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": { "set": { "type": "integer", "minimum": 0, "maximum": 4095 } },
                          "required": ["set"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": { "wait_ms": { "type": "integer", "minimum": 0 } },
                          "required": ["wait_ms"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": ["via", "steps"],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "macro",
          "address",
          "title",
          "author",
          "description",
          "clock_hz",
          "tiles",
          "analog_pins",
          "repo",
          "commit",
          "pinout"
        ]
      }
    }
  },
  "required": ["version", "id", "name", "repo", "commit", "projects"]
}
